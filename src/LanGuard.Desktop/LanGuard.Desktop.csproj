<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>LanGuard.Desktop</AssemblyName>
    <Product>LAN Guard</Product>
    <Version>0.3.5</Version>
    <ApplicationIcon>Assets/LanGuard.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LanGuard.Shared/LanGuard.Shared.csproj" />
    <PackageReference Include="System.Management" Version="10.0.15" />
    <EmbeddedResource Include="../../signatures/remote-access.json" LogicalName="LanGuard.Signatures.json" />
    <EmbeddedResource Include="Assets/LanGuard-logo.png" LogicalName="LanGuard.Logo.png" />
  </ItemGroup>
</Project>
